---
/**
 * M3E 博客原子 — FooterBar 页脚栏。
 * 数据驱动：copyright + 可折叠链接组；链接 primary 强调。
 */
import Icon from "@components/atoms/display/Icon.svelte";

interface FooterLink {
	label: string;
	href: string;
	external?: boolean;
}

interface Props {
	/** 站点 / 作者名（可选） */
	name?: string;
	/** 版权年份（可选） */
	year?: number;
	links?: FooterLink[];
	/** 自定义注入的页脚 HTML（来自 FooterConfig.html） */
	customHtml?: string;
	class?: string;
}

const {
	name,
	year,
	links = [],
	customHtml = "",
	class: className,
} = Astro.props;
---

<footer class:list={["m3-blog-footer", className]}>
	<div class="m3-blog-footer__inner">
		{customHtml && <div class="m3-blog-footer__custom" set:html={customHtml} />}
		{links.length > 0 ? (
			<details class="m3-blog-footer__details">
				<summary class="m3-blog-footer__summary" aria-label="Toggle footer links">
					<span class="m3-blog-footer__text">
						&copy; {year ? `${year} ` : ""}{name ? `${name} ` : ""}All Rights Reserved
					</span>
					<Icon icon="material-symbols:keyboard-arrow-down-rounded" class="m3-blog-footer__arrow" />
				</summary>
				<div class="m3-blog-footer__links">
					{links.map((l, idx) => (
						<Fragment>
							{idx > 0 && <span class="m3-blog-footer__sep" aria-hidden="true">/</span>}
							<a
								class="m3-blog-footer__link"
								href={l.href}
								target={l.external ? "_blank" : undefined}
								rel={l.external ? "noopener noreferrer" : undefined}
							>{l.label}</a>
						</Fragment>
					))}
				</div>
			</details>
		) : (
			<p class="m3-blog-footer__text">
				&copy; {year ? `${year} ` : ""}{name ? `${name} ` : ""}All Rights Reserved
			</p>
		)}
	</div>
</footer>

<style lang="stylus">
.m3-blog-footer
	&__inner
		display: flex
		flex-direction: column
		align-items: center
		gap: 0.375rem
		margin: 1rem auto 2rem
		padding: 0 1rem
		text-align: center

	&__text,
	&__custom
		font: var(--m3e-type-body-medium)
		font-size: 0.9375rem
		color: var(--on-surface-variant)
		line-height: 1.5
		a
			font-weight: 500
			color: var(--primary)
			text-decoration: none
			transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)
			&:hover
				opacity: 0.8

	&__details
		display: flex
		flex-direction: column
		align-items: center
		&[open] .m3-blog-footer__arrow
			transform: rotate(180deg)

	&__summary
		display: inline-flex
		align-items: center
		justify-content: center
		gap: 0.375rem
		cursor: pointer
		color: var(--on-surface-variant)
		list-style: none
		padding: 0.25rem 0.5rem
		border-radius: var(--shape-corner-small, 8px)
		user-select: none
		transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard), color var(--m3e-duration-short) var(--m3e-easing-standard), background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		&::-webkit-details-marker
			display: none
		&:hover
			color: var(--on-surface)
			background-color: var(--surface-container-highest, rgba(255, 255, 255, 0.05))
			.m3-blog-footer__arrow
				color: var(--primary)

	&__arrow
		font-size: 1.25rem
		color: var(--on-surface-variant)
		transition: transform var(--m3e-duration-short) var(--m3e-easing-standard), color var(--m3e-duration-short) var(--m3e-easing-standard)
		flex-shrink: 0

	&__links
		display: flex
		align-items: center
		justify-content: center
		flex-wrap: wrap
		gap: 0.125rem
		margin-top: 0.375rem
		font: var(--m3e-type-body-small)

	&__link
		font-weight: 500
		color: var(--primary)
		text-decoration: none
		transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			opacity: 0.8

	&__sep
		margin: 0 0.375rem
		color: var(--outline-variant)
</style>
