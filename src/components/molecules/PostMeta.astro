---
import PostMeta from "@components/atoms/blog/PostMeta.astro";
/**
 * 文章元信息行（消费 blog/PostMeta 原子）。
 * 只负责取数转 props：日期格式化、分类/标签 URL、i18n 占位文案。
 */
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { formatDateToYYYYMMDD, formatLocalizedDate } from "@utils/date-utils";
import { getCategoryUrl, getTagUrl } from "@utils/url-utils";

interface Props {
	class?: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideUpdateDate?: boolean;
	localizedDate?: boolean;
	lang?: string;
	stacked?: boolean;
}
const {
	class: className,
	published,
	updated,
	tags,
	category,
	hideUpdateDate = false,
	localizedDate = false,
	lang,
	stacked = false,
} = Astro.props;

const categoryLink = category
	? { name: category, href: getCategoryUrl(category) }
	: null;
const tagLinks = tags.map((t) => ({ name: t.trim(), href: getTagUrl(t) }));

const formattedPublished = localizedDate
	? formatLocalizedDate(published, lang)
	: formatDateToYYYYMMDD(published);
const formattedUpdated = updated
	? localizedDate
		? formatLocalizedDate(updated, lang)
		: formatDateToYYYYMMDD(updated)
	: undefined;
---

<PostMeta
	class={className}
	published={formattedPublished}
	updated={formattedUpdated}
	category={categoryLink}
	tags={tagLinks}
	hideUpdate={hideUpdateDate}
	stacked={stacked}
	uncategorizedLabel={i18n(I18nKey.uncategorized)}
	noTagsLabel={i18n(I18nKey.noTags)}
/>
