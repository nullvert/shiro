---
/**
 * 站点统计侧栏 widget（规格表风格）。
 * 行 = MetaIcon tonal 徽标 + 标签 + 点线引导 + 表格数字，
 * 与 PostMeta 的元信息语言同源；数据来自 utils/site-stats（备忘化汇总）。
 */
import Icon from "@components/atoms/display/Icon.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSiteStats } from "@utils/site-stats";
import { seriesConfig } from "@/config";
import type { StatsWidget } from "@/types/sidebarConfig";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	widget?: StatsWidget;
}

const className = Astro.props.class;
const style = Astro.props.style;

const stats = await getSiteStats();
// 千位分隔固定 en-US：构建产物数值稳定，不随构建机 locale 漂移
const fmt = (n: number) => n.toLocaleString("en-US");
---

<WidgetLayout
	name={i18n(I18nKey.stats)}
	icon="material-symbols:equalizer-rounded"
	id="site-stats"
	class={className}
	style={style}
>
	<div class="m3-stats-bento">
		{/* 1. ПОСТЫ (главный геройский блок на всю ширину) */}
		<div class="m3-stats-bento__hero">
			<div class="m3-stats-bento__watermark" aria-hidden="true">
				<Icon icon="material-symbols:article-outline-rounded" />
			</div>
			<span class="m3-stats-bento__hero-lbl">{i18n(I18nKey.statsPosts)}</span>
			<span class="m3-stats-bento__hero-val">{fmt(stats.posts)}</span>
		</div>

		{/* 2. ТАКСОНОМИЯ (сетка 2x2: заголовок вверху, крупная цифра, фоновая иконка) */}
		<div class:list={["m3-stats-bento__grid", seriesConfig.enable ? "m3-stats-bento__grid--4" : "m3-stats-bento__grid--3"]}>
			<div class="m3-stats-bento__tile">
				<div class="m3-stats-bento__watermark" aria-hidden="true">
					<Icon icon="material-symbols:forum-outline-rounded" />
				</div>
				<span class="m3-stats-bento__tile-lbl">{i18n(I18nKey.moments)}</span>
				<span class="m3-stats-bento__tile-val">{fmt(stats.moments)}</span>
			</div>

			<div class="m3-stats-bento__tile">
				<div class="m3-stats-bento__watermark" aria-hidden="true">
					<Icon icon="material-symbols:folder-outline-rounded" />
				</div>
				<span class="m3-stats-bento__tile-lbl">{i18n(I18nKey.categories)}</span>
				<span class="m3-stats-bento__tile-val">{fmt(stats.categories)}</span>
			</div>

			<div class="m3-stats-bento__tile">
				<div class="m3-stats-bento__watermark" aria-hidden="true">
					<Icon icon="material-symbols:tag-rounded" />
				</div>
				<span class="m3-stats-bento__tile-lbl">{i18n(I18nKey.tags)}</span>
				<span class="m3-stats-bento__tile-val">{fmt(stats.tags)}</span>
			</div>

			{seriesConfig.enable && (
				<div class="m3-stats-bento__tile">
					<div class="m3-stats-bento__watermark" aria-hidden="true">
						<Icon icon="material-symbols:view-carousel-outline-rounded" />
					</div>
					<span class="m3-stats-bento__tile-lbl">{i18n(I18nKey.series)}</span>
					<span class="m3-stats-bento__tile-val">{fmt(stats.series)}</span>
				</div>
			)}
		</div>
	</div>
</WidgetLayout>

<style lang="stylus">
.m3-stats-bento
	display: flex
	flex-direction: column
	gap: 0.625rem

	/* ФОНОВАЯ ИКОНКА ДЛЯ ВСЕХ КАРТОЧЕК */
	&__watermark
		position: absolute
		right: 0.375rem
		bottom: 0.125rem
		font-size: 2.75rem
		color: var(--primary)
		opacity: 0.12
		pointer-events: none
		user-select: none
		line-height: 1
		display: flex
		align-items: center
		justify-content: center

	/* ГЕРОЙСКАЯ КАРТОЧКА: ПОСТЫ */
	&__hero
		position: relative
		overflow: hidden
		display: flex
		flex-direction: column
		align-items: flex-start
		justify-content: space-between
		padding: 1rem 1.125rem
		min-height: 5.25rem
		border-radius: 0.875rem
		background: var(--surface-container-low)
		border: 1px solid unquote("color-mix(in oklab, var(--outline-variant) 45%, transparent)")
		box-shadow: 0 1px 2px unquote("color-mix(in oklab, var(--outline) 6%, transparent)")
		transition: background var(--m3e-duration-short) var(--m3e-easing-standard), border-color var(--m3e-duration-short) var(--m3e-easing-standard)

		:global(.dark) &
			background: unquote("color-mix(in oklab, var(--card-bg) 75%, var(--surface-container-highest) 25%)")
			border-color: unquote("color-mix(in oklab, var(--outline-variant) 25%, transparent)")
			box-shadow: none

		.m3-stats-bento__watermark
			font-size: 3.75rem
			right: 0.875rem
			bottom: 0.25rem
			opacity: 0.16

	&__hero-lbl
		font-size: 0.6875rem
		font-weight: 700
		text-transform: uppercase
		letter-spacing: 0.08em
		color: var(--on-surface-variant)
		position: relative
		z-index: 1

	&__hero-val
		font-size: 2.125rem
		font-weight: 800
		line-height: 1
		margin-top: 0.375rem
		color: var(--on-surface)
		font-variant-numeric: tabular-nums
		letter-spacing: -0.03em
		position: relative
		z-index: 1

	/* СЕТКА 2x2 ДЛЯ ОСТАЛЬНЫХ МЕТРИК */
	&__grid
		display: grid
		gap: 0.625rem

		&--3
			grid-template-columns: repeat(3, 1fr)

		&--4
			grid-template-columns: repeat(2, 1fr)

	&__tile
		position: relative
		overflow: hidden
		display: flex
		flex-direction: column
		align-items: flex-start
		justify-content: space-between
		padding: 0.875rem 1rem
		min-height: 4.75rem
		border-radius: 0.875rem
		background: var(--surface-container-low)
		border: 1px solid unquote("color-mix(in oklab, var(--outline-variant) 45%, transparent)")
		box-shadow: 0 1px 2px unquote("color-mix(in oklab, var(--outline) 6%, transparent)")
		transition: background var(--m3e-duration-short) var(--m3e-easing-standard), border-color var(--m3e-duration-short) var(--m3e-easing-standard)

		:global(.dark) &
			background: unquote("color-mix(in oklab, var(--card-bg) 75%, var(--surface-container-highest) 25%)")
			border-color: unquote("color-mix(in oklab, var(--outline-variant) 25%, transparent)")
			box-shadow: none

	&__tile-lbl
		font-size: 0.6875rem
		font-weight: 600
		letter-spacing: 0.02em
		color: var(--on-surface-variant)
		position: relative
		z-index: 1

	&__tile-val
		font-size: 1.625rem
		font-weight: 800
		line-height: 1
		margin-top: 0.375rem
		color: var(--on-surface)
		font-variant-numeric: tabular-nums
		letter-spacing: -0.02em
		position: relative
		z-index: 1
</style>
