---
import Button from "@components/atoms/action/Button.svelte";
import Icon from "@components/atoms/display/Icon.svelte";
import WidgetLayout from "@components/molecules/WidgetLayout.astro";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { profileConfig } from "@/config";
import type { ProfileWidget } from "@/types/sidebarConfig";

interface Props {
	class?: string;
	style?: string;
	widget?: ProfileWidget;
	priority?: boolean;
}

const className = Astro.props.class;
const style = Astro.props.style;

const config = profileConfig;
---
<WidgetLayout
	id="profile"
	name={i18n(I18nKey.authorMenu)}
	icon="material-symbols:explore-outline-rounded"
	class={className}
	style={style}
>
	{config.links.length > 0 && (
		<nav class="m3-author-menu flex flex-col gap-0.5" aria-label={i18n(I18nKey.authorMenu)}>
			{config.links.map(item => (
				<Button
					href={item.url}
					target="_blank"
					rel="me"
					variant="text"
					size="small"
					full
					align="between"
					class="!px-2 !text-[var(--on-surface)] group"
				>
					<span class="flex items-center gap-2.5 min-w-0">
						<Icon
							icon={item.icon}
							class="text-[1.25rem] text-[var(--on-surface-variant)] shrink-0 transition-colors group-hover:text-[var(--primary)]"
						/>
						<span class="truncate font-medium transition-colors group-hover:text-[var(--primary)]">
							{item.name}
						</span>
					</span>
					<Icon
						icon="material-symbols:arrow-outward-rounded"
						class="text-[1.125rem] text-[var(--on-surface-variant)] shrink-0 opacity-40 transition-all group-hover:opacity-100 group-hover:text-[var(--primary)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
					/>
				</Button>
			))}
		</nav>
	)}

	<UmamiStats variant="profile" />
</WidgetLayout>

<style lang="stylus">
.m3-profile
	display: flex
	flex-direction: column
	gap: var(--m3e-space-2)

	&__header
		display: flex
		align-items: center
		gap: var(--m3e-space-3)
		padding: var(--m3e-space-1) var(--m3e-space-2)
		border-radius: var(--shape-corner-m)
		text-decoration: none
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			background-color: var(--surface-container-high)
		&:focus-visible
			outline: 2px solid var(--primary)
			outline-offset: 2px

	&__avatar-wrap
		position: relative
		display: flex
		align-items: center
		justify-content: center

	&__name
		font: var(--m3e-type-title-medium)
		font-weight: 700
		color: var(--on-surface)
		transition: color var(--m3e-duration-short) var(--m3e-easing-standard)
		.group:hover &
			color: var(--primary)
</style>
